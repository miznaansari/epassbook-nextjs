datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String           @id // Firebase UID
  email              String           @unique
  name               String?
  salaryCycleDate    Int              @default(1) // Default to 1st of month (1 to 31)
  currency           String           @default("USD") // Currency preference (USD, INR, etc.)
  dailyReminderTime  String           @default("23:00") // Time to alert user daily (HH:MM format)
  notifSalary        Boolean          @default(true) // Enable celebratory salary toast notification
  notifDaily         Boolean          @default(true) // Enable daily reminder notification
  notifCycle         Boolean          @default(true) // Enable end of cycle analysis notification
  notifDailySpend    Boolean          @default(true) // Enable daily spending summary reminder
  dailySpendReminderTime String       @default("22:00") // Time to alert daily spend summary (HH:MM format)
  oneSignalId        String?          // OneSignal User ID (onesignalId)
  oneSignalSubId     String?          // OneSignal Push Subscription ID
  timezone           String           @default("UTC") // User timezone for notifications
  lastDailyReminderSentAt DateTime?   // To prevent double sending within local days
  lastDailySpendReminderSentAt DateTime? // To prevent double sending of daily spend summary
  lastSalaryReminderSentAt DateTime?   // To prevent double sending of salary celebration after a day
  lastCycleReminderSentAt  DateTime?   // To prevent double sending of cycle end review
  notifStreakLevel1  Boolean          @default(true) // Enable Level 1 streak notification
  notifStreakLevel2  Boolean          @default(true) // Enable Level 2 streak notification
  streakLevel2Limit  Decimal          @db.Decimal(12, 2) @default(100.00) // Spend limit for Level 2 streak
  streakLevel1       Int              @default(0) // Current Level 1 streak
  streakLevel2       Int              @default(0) // Current Level 2 streak
  lastStreakLevel1SentAt DateTime?    // Avoid double sending Level 1 streak notifications
  lastStreakLevel2SentAt DateTime?    // Avoid double sending Level 2 streak notifications
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  salaries           Salary[]
  bonuses            Bonus[]
  financialEntries   FinancialEntry[]
  sessions           UserSession[]
  broadcasts         NotificationBroadcast[]
  chatSessions       ChatSession[]
  stockHoldings      StockHolding[]
  stockApiUsages     StockApiUsage[]
  notificationCampaigns NotificationCampaign[]
}

model UserSession {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Admin {
  id        String         @id @default(uuid())
  email     String         @unique
  password  String         // Store standard passwords safely
  name      String?
  sessions  AdminSession[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model AdminSession {
  id        String   @id @default(uuid())
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model NotificationBroadcast {
  id        String   @id @default(uuid())
  title     String
  body      String
  target    String   @default("ALL") // "ALL" or specific user id/email
  readBy    String?  @db.Text        // Comma-separated user IDs who marked it read
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Salary {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Decimal  @db.Decimal(12, 2)
  month     Int      // 1 to 12
  year      Int      // e.g. 2026
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, month, year])
}

enum EntryType {
  LENDING
  LOAN
  SPENDING
  ADVANCE
  SAVINGS
}

model FinancialEntry {
  id                 Int       @id @default(autoincrement())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount             Decimal   @db.Decimal(12, 2)
  title              String
  description        String?   @db.Text
  type               EntryType
  useSalaryBalance   Boolean   @default(false)
  salaryMonth        Int?      // Month from which salary is deducted (if useSalaryBalance = true)
  salaryYear         Int?      // Year from which salary is deducted (if useSalaryBalance = true)
  date               DateTime  @default(now())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deductions         SalaryDeduction[]
  parentEntryId      Int?
}

model ChatSession {
  id        String        @id @default(uuid())
  title     String        @default("New Chat")
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model ChatMessage {
  id            String      @id @default(uuid())
  chatSessionId String
  chatSession   ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
  role          String      // "user" or "assistant"
  content       String      @db.Text
  createdAt     DateTime    @default(now())
}

model Bonus {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Decimal  @db.Decimal(12, 2)
  month     Int      // 1 to 12
  year      Int      // e.g. 2026
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, month, year])
}

model SalaryDeduction {
  id        Int            @id @default(autoincrement())
  entryId   Int
  entry     FinancialEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  month     Int
  year      Int
  amount    Decimal        @db.Decimal(12, 2)
  type      String         // "SALARY" or "BONUS"
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model StockHolding {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol    String   // e.g. "ADANIPOWER.NS"
  name      String   // e.g. "Adani Power Ltd"
  quantity  Int
  buyPrice  Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StockPrice {
  symbol    String   @id // e.g. "ADANIPOWER.NS"
  price     Decimal  @db.Decimal(12, 2)
  updatedAt DateTime @updatedAt
}

model StockApiUsage {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String   // YYYY-MM-DD
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}

model NotificationCampaign {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  message     String    @db.Text
  frequency   String    // "DAILY", "WEEKLY", "MONTHLY", "SIX_MONTHS"
  time        String    @default("12:00") // HH:MM target time
  isActive    Boolean   @default(true)
  isDeleted   Boolean   @default(false)
  lastSentAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
